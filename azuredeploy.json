{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "resourceGroupName": {
      "type": "string",
      "defaultValue": "fastapi-rg",
      "metadata": {
        "description": "Name of the Resource Group"
      }
    },
    "webAppName": {
      "type": "string",
      "defaultValue": "fastapi-webapp-123",
      "metadata": {
        "description": "Name of the Azure Web App"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "East US",
      "metadata": {
        "description": "Azure region for deployment"
      }
    },
    "databaseName": {
      "type": "string",
      "defaultValue": "fastapidb",
      "metadata": {
        "description": "PostgreSQL database name"
      }
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "pgadmin",
      "metadata": {
        "description": "Database admin username"
      }
    },
    "adminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Database admin password"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2021-06-01",
      "name": "[parameters('databaseName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "GP_Standard_D2s_v3",
        "tier": "GeneralPurpose"
      },
      "properties": {
        "administratorLogin": "[parameters('adminUsername')]",
        "administratorLoginPassword": "[parameters('adminPassword')]",
        "version": "12",
        "storage": {
          "storageSizeGB": 32
        }
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2021-02-01",
      "name": "[parameters('webAppName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "F1",
        "tier": "Free"
      },
      "properties": {
        "perSiteScaling": false,
        "maximumElasticWorkerCount": 1
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2021-02-01",
      "name": "[parameters('webAppName')]",
      "location": "[parameters('location')]",
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('webAppName'))]",
        "siteConfig": {
          "linuxFxVersion": "PYTHON|3.10"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('databaseName'))]",
        "[resourceId('Microsoft.Web/serverfarms', parameters('webAppName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2021-02-01",
      "name": "[concat(parameters('webAppName'), '/web')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('webAppName'))]"
      ],
      "properties": {
        "appSettings": [
          {
            "name": "DATABASE_URL",
            "value": "[concat('postgresql+asyncpg://', parameters('adminUsername'), ':', parameters('adminPassword'), '@', parameters('databaseName'), '.postgres.database.azure.com/', parameters('databaseName'))]"
          }
        ]
      }
    }
  ]
}
